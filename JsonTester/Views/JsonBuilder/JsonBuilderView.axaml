<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:jsonvm="clr-namespace:JsonTester.ViewModels.JsonBuilder"
             xmlns:jsonview="clr-namespace:JsonTester.Views.JsonBuilder"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="630"
             x:Class="JsonTester.Views.JsonBuilder.JsonBuilderView"
             x:DataType="jsonvm:JsonBuilderViewModel"
             CornerRadius="16">
    
    <Design.DataContext>
        <jsonvm:JsonBuilderViewModel/>
    </Design.DataContext>
    
    <UserControl.Styles>
        <Style Selector="Grid.json-builder-grid StackPanel">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="DockPanel.json-builder-top-dock Button">
            <Setter Property="Background" Value="#f0f0f0"/>
            <Setter Property="BorderBrush" Value="#1a1a1a" />
            <Setter Property="Height" Value="25"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="8,2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto, Auto, *"
          Classes="json-builder-grid">
        <Border Grid.Row="0"
                BorderBrush="#1a1a1a"
                BorderThickness="0, 0, 0, 1"
                Background="#fafafa"
                Height="38"
                Padding="12, 0">
            <DockPanel Classes="json-builder-top-dock">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                    <Button Content="비우기"/>
                    <Button Content="스키마 가져오기" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="JSON 빌더" FontWeight="Bold" />
                    <TextBlock Text="·"
                               Foreground="#5d5d5d"/>
                    <TextBlock Text="로그인 요청"
                               Foreground="#5d5d5d"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <Border Grid.Row="1"
                BorderBrush="#1a1a1a"
                BorderThickness="0, 0, 0, 1"
                Background="#fafafa"
                Height="32"
                Padding="12, 0">
            <TextBlock Text="6 개 필드"
                       Foreground="#9a9a9a"
                       FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Border>
        
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Top">
            <ItemsControl Padding="8"
                          ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="jsonvm:JsonNodeViewModel">
                        <jsonview:JsonNodeView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ 필드 추가" Command="{Binding AddNodeCommand}"
                    Margin="16, 0, 0, 0"
                    Background="#f0f0f0"
                    BorderBrush="#5d5d5d"/>
        </StackPanel>
        
    </Grid>
</UserControl>
